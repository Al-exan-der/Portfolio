---
import "../styles/global.css";
import { Font } from "astro:assets";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const titulo = "Alexis Gómez | Desarrollo web";
const descripcion =
  "Portfolio de Alexis Gómez, estudiante de desarrollo web. Proyectos en HTML, CSS, JavaScript, PHP, Java y Astro.";
// El año se calcula al generar la página: se actualiza cada vez que se publica.
const anio = new Date().getFullYear();
// Las vistas previas (WhatsApp, LinkedIn) piden direcciones completas, con https://
const urlPagina = new URL(Astro.url.pathname, Astro.site);
const urlVistaPrevia = new URL(`${base}/imagenes/vista-previa.png`, Astro.site);
const redes = [
  {
    nombre: "GitHub",
    enlace: "https://github.com/Al-exan-der",
    icono: "github-icon.svg",
    externo: true,
  },
  {
    nombre: "LinkedIn",
    enlace: "https://www.linkedin.com/in/alexis-g%C3%B3mez-a4461a356/",
    icono: "linkedin-plain.svg",
    externo: true,
  },
  {
    nombre: "Email",
    enlace: "mailto:alexgome7i@gmail.com",
    icono: "google-gmail.svg",
    externo: false,
  },
];
const iconosTecnologias: Record<string, string> = {
  HTML: "html-5.svg",
  CSS: "css-3.svg",
  JavaScript: "javascript.svg",
  PHP: "php.svg",
  MariaDB: "mariadb.svg",
  XAMPP: "xampp.svg",
  Java: "java.svg",
  NetBeans: "netbeans.svg",
};
const proyectos = [
  {
    titulo: "Proyecto Islas",
    descripcion:
      "Sitio web de la Escuela Técnica N°3 Islas Malvinas donde se pueden ver las tecnicaturas y la ubicación, y simular una inscripción. Hecho sin frameworks. Mi parte: todo el CSS y la planificación del diseño.",
    enlace: "https://github.com/Nitram-2921/Proyecto-islas",
    imagen: "imagenes/proyectos/islas.webp",
    tecnologias: ["HTML", "CSS", "JavaScript"],
  },
  {
    titulo: "Reactstore",
    descripcion: "Tienda ficticia de videojuegos donde se puede iniciar sesión y agregar juegos al carrito. Los datos se guardan en una base de datos MariaDB. Mi parte: gran parte del CSS, todo el JavaScript y la corrección de varios errores del PHP.",
    enlace: "https://github.com/Al-exan-der/Reactstore",
    imagen: "imagenes/proyectos/reactstore.webp",
    tecnologias: ["HTML", "CSS", "JavaScript", "PHP", "MariaDB", "XAMPP"],
  },
  {
    titulo: "Tetris en Java",
    descripcion: "Tetris basado en la versión clásica, con puntaje y niveles. Mi parte: el sistema de puntajes, los niveles y parte de la lógica del juego.",
    enlace: "https://github.com/Luketi308/Tetris",
    imagen: "imagenes/proyectos/tetris.webp",
    tecnologias: ["Java", "NetBeans"],
  },
];
---

<html lang="es">
  <head>
    <Font cssVariable="--font-oxanium" />
    <Font cssVariable="--font-inter" />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c090a" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlPagina} />

    <!-- Cómo se ve el enlace cuando se comparte (WhatsApp, LinkedIn, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={urlVistaPrevia} />
    <meta property="og:image:alt" content="Alexis Gómez, estudiante de desarrollo web" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <nav class="contenedor">
        <ul>
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#proyectos">Proyectos</a></li>
          <li>
            <a href={`${base}/documentos/CV-Alexis-Gomez.pdf`} target="_blank" rel="noopener">
              CV
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main class="contenedor">
      <section id="inicio" class="portada">
        <img
          class="avatar"
          src={`${base}/imagenes/perfil.webp`}
          alt="Avatar de Alexis Gómez con la letra A"
          width="400"
          height="400"
        />
        <div class="portada-texto">
          <h1>Alexis Gómez</h1>
          <p class="rol">Estudiante de desarrollo web</p>
          <p>
            Tengo base en HTML, CSS y JavaScript, y
            proyectos hechos en Java, Astro y PHP. Me gusta armar la lógica de
            las páginas y resolver los problemas que se presentan. Busco una
            primera experiencia laboral para poder complementar mi aprendizaje
            con trabajo real.
          </p>
          <ul class="redes">
            {redes.map((r) => (
              <li>
                <a
                  class="icono"
                  href={r.enlace}
                  target={r.externo ? "_blank" : undefined}
                  rel={r.externo ? "noopener" : undefined}
                  aria-label={r.nombre}
                  style={`--icono: url(${base}/iconos/${r.icono})`}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
      <section id="proyectos">
        <h2>Proyectos</h2>
        <div class="grilla">
          {proyectos.map((p) => (
            <article class="card">
              <a
                class="card-imagen"
                href={p.enlace}
                target="_blank"
                rel="noopener"
                aria-label={`Ver el repositorio de ${p.titulo} en GitHub`}
              >
                <img
                  src={`${base}/${p.imagen}`}
                  alt={`Captura de ${p.titulo}`}
                  loading="lazy"
                />
                <span class="card-overlay" aria-hidden="true">
                  Ver repositorio en GitHub
                </span>
              </a>
              <h3>{p.titulo}</h3>
              <p>{p.descripcion}</p>
              <ul class="tecnologias" aria-label="Tecnologías usadas">
                {p.tecnologias.map((t) => (
                  <li>
                    <span
                      class="icono icono-tec"
                      role="img"
                      aria-label={t}
                      title={t}
                      style={`--icono: url(${base}/iconos/${iconosTecnologias[t]})`}
                    />
                  </li>
                ))}
              </ul>
              <a class="boton" href={p.enlace} target="_blank" rel="noopener">
                Ver proyecto
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>
    <footer class="contenedor">
      <p>© {anio}, Alexis Gómez</p>
      <ul class="redes">
        {redes.map((r) => (
          <li>
            <a
              class="icono"
              href={r.enlace}
              target={r.externo ? "_blank" : undefined}
              rel={r.externo ? "noopener" : undefined}
              aria-label={r.nombre}
              style={`--icono: url(${base}/iconos/${r.icono})`}
            />
          </li>
        ))}
      </ul>
    </footer>
  </body>
</html>
