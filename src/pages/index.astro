---
import "../styles/global.css";
import { Font } from "astro:assets";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const proyectos = [
  {
    titulo: "Proyecto Islas",
    descripcion:
      "Sitio web de la escuela técnica, hecho en HTML, CSS y JavaScript para la Feria de Ciencias.",
    enlace: "https://github.com/Nitram-2921/Proyecto-islas",
    imagen: "Islas.png",
  },
  {
    titulo: "Reactstore",
    descripcion: "Tienda ficticia de videojuegos, hecha con PHP y JavaScript.",
    enlace: "https://github.com/Al-exan-der/Reactstore",
    imagen: "reactstore.png",
  },
  {
    titulo: "Tetris en Java",
    descripcion: "Tetris con puntaje y niveles, hecho en Java.",
    enlace: "https://github.com/Luketi308/Tetris",
    imagen: "Tetris.png",
  },
];
---

<html lang="es">
  <head>
    <Font cssVariable="--font-oxanium" />
    <Font cssVariable="--font-inter" />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Alexis Gómez | Desarrollo web</title>
    <meta
      name="description"
      content="Portfolio de Alexis Gómez, estudiante de desarrollo web. Proyectos en HTML, CSS, JavaScript, PHP, Java y Astro."
    />
  </head>
  <body>
    <header class="contenedor">
      <nav>
        <ul>
          <li>
            <a href="#inicio">Inicio</a>
          </li>
          <li>
            <a href="#proyectos">Proyectos</a>
          </li>
          <li>
            <a
              href={`${base}/Alexis%20Gomez.pdf`}
              target="_blank"
              rel="noopener"
            >
              CV
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main class="contenedor">
      <section id="inicio" class="portada">
        <img
          class="avatar"
          src={`${base}/perfil.png`}
          alt="Foto de Alexis Gómez"
          width="300"
          height="300"
        />
        <div class="portada-texto">
          <h1>Alexis Gómez</h1>
          <p class="rol">Estudiante de desarrollo web</p>
          <p>
            Estudiante de desarrollo web con base en HTML, CSS y JavaScript, y
            proyectos hechos en Java, Astro y PHP. Me gusta armar la lógica de
            las páginas y resolver los problemas que se presentan. Busco una
            primera experiencia laboral para poder complementar mi aprendizaje
            con trabajo real.
          </p>
          <ul class="redes">
            <li>
              <a
                class="icono"
                href="https://github.com/Al-exan-der"
                target="_blank"
                rel="noopener"
                aria-label="GitHub"
                style={`--icono: url(${base}/iconos/github-icon.svg)`}
              ></a>
            </li>
            <li>
              <a
                class="icono"
                href="https://www.linkedin.com/in/alexis-g%C3%B3mez-a4461a356/"
                target="_blank"
                rel="noopener"
                aria-label="LinkedIn"
                style={`--icono: url(${base}/iconos/linkedin-plain.svg)`}
              ></a>
            </li>
            <li>
              <a
                class="icono"
                href="mailto:alexgome7i@gmail.com"
                aria-label="Email"
                style={`--icono: url(${base}/iconos/google-gmail.svg)`}
              ></a>
            </li>
          </ul>
        </div>
      </section>
      <section id="proyectos">
        <h2>Proyectos</h2>
        <div class="grilla">
          {proyectos.map((p) => (
            <article class="card">
              <a
                class="card-imagen"
                href={p.enlace}
                target="_blank"
                rel="noopener"
                aria-label={`Ver el repositorio de ${p.titulo} en GitHub`}
              >
                <img
                  src={`${base}/${p.imagen}`}
                  alt={`Captura de ${p.titulo}`}
                  loading="lazy"
                />
                <span class="card-overlay" aria-hidden="true">
                  Ver repositorio en GitHub
                </span>
              </a>
              <h3>{p.titulo}</h3>
              <p>{p.descripcion}</p>
              <a class="boton" href={p.enlace} target="_blank" rel="noopener">
                Ver proyecto
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>
    <footer class="contenedor">
      <p>© 2026, Alexis Gómez</p>
    </footer>
  </body>
</html>
