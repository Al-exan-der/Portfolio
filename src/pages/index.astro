---
import "../styles/global.css";
import { Font } from "astro:assets";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const proyectos = [
  {
    titulo: "Proyecto Islas",
    descripcion:
      "Sitio web de la escuela técnica, hecho para la Feria de Ciencias.",
    enlace: "#",
  },
  {
    titulo: "Reactstore",
    descripcion: "Tienda web con diseño adaptable a celular y escritorio.",
    enlace: "#",
  },
  {
    titulo: "Tetris en Java",
    descripcion: "Tetris con puntaje y niveles, hecho en Java.",
    enlace: "#",
  },
];
---

<html lang="es">
  <head>
    <Font cssVariable="--font-oxanium" />
    <Font cssVariable="--font-inter" />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Portfolio</title>
  </head>
  <body>
    <header class="contenedor">
      <nav>
        <ul>
          <li>
            <a href="#inicio">Inicio</a>
          </li>
          <li>
            <a href="#proyectos">Proyectos</a>
          </li>
          <li>
            <a
              href={`${base}/Alexis%20Gomez.pdf`}
              target="_blank"
              rel="noopener"
            >
              CV
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main class="contenedor">
      <section id="inicio" class="portada">
        <img
          class="avatar"
          src={`${base}/perfil.png`}
          alt="Foto de Alexis Gomez"
          width="300"
          height="300"
        />
        <div class="portada-texto">
          <h1>Alexis Gomez</h1>
          <p class="rol">Estudiante de desarrollo web</p>
          <p>Tu descripción: quién sos y qué buscás, en dos o tres líneas.</p>
          <ul class="redes">
            <li>
              <a href="https://github.com/Al-exan-der" target="_blank" rel="noopener">
                GitHub
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/alexis-g%C3%B3mez-a4461a356/" target="_blank" rel="noopener">
                LinkedIn
              </a>
            </li>
            <li>
              <a href="alexgome7i@gmail.com">Email</a>
            </li>
          </ul>
        </div>
      </section>
      <section id="proyectos">
        <h2>Proyectos</h2>
        <div class="grilla">
          {proyectos.map((p) => (
            <article class="card">
              <div class="card-imagen"></div>
              <h3>{p.titulo}</h3>
              <p>{p.descripcion}</p>
              <a class="boton" href={p.enlace} target="_blank" rel="noopener">
                Ver proyecto
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>
    <footer class="contenedor">
      <p>© 2026, Alexis Gomez</p>
    </footer>
  </body>
</html>
